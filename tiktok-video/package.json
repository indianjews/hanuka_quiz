{
  "name": "hanukkah-quiz-tiktok",
  "version": "1.0.0",
  "description": "TikTok promo video for Indian Jewish Hanukkah Quiz",
  "scripts": {
    "start": "npx remotion studio",
    "render:he": "npx remotion render HanukkahPromoHE out/hanukkah-tiktok-he.mp4 --codec=h264",
    "render:en": "npx remotion render HanukkahPromoEN out/hanukkah-tiktok-en.mp4 --codec=h264",
    "render:all": "npm run render:he && npm run render:en"
  },
  "dependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
